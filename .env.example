# Copie ce fichier en ".env" (même dossier) et remplis les valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub (il est dans .gitignore).

# Supabase > Project Settings > API Keys
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Clé publishable (lecture seule) : utilisée par l'app Streamlit (app.py)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Google Sheet "Matrice de passage" : ID dans l'URL (entre /d/ et /edit)
SHEET_ID=1i_PB1GW9v_wIHYUn5sd08mzb2EUtB7GXq3hLMeN8o1I
# gid de chaque onglet : clique sur l'onglet, puis copie le nombre après "#gid=" dans l'URL
GID_SPOT_PROPERTIES=
GID_SPOT_CONDITIONS=
GID_LEVEL_CONDITIONS=
