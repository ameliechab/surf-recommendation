# Copie ce fichier en "secrets.toml" (même dossier) et remplis les deux valeurs.
# secrets.toml ne doit JAMAIS être envoyé sur GitHub (il est dans .gitignore).
# Sur Streamlit Community Cloud, colle ces deux lignes dans App settings > Secrets.

# Supabase > Project Settings > API Keys : clé "publishable" (lecture seule), pas la clé secrète
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_xxxxxxxxxxxxxxxx"
